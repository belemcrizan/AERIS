# AERIS local-first configuration. Copy to .env as needed.
# None of these are required to run tests.

AERIS_DB_PATH=./data/aeris.db
AERIS_HOST=127.0.0.1
AERIS_PORT=8000
AERIS_OTEL_ENABLED=false
AERIS_OTEL_SERVICE_NAME=aeris
AERIS_HUMAN_ON_CRITICAL=true
AERIS_MAX_RETRIES=2
AERIS_MAX_ROUTE_CHANGES=3
AERIS_HOLD_MS=50
